<?xml version="1.0" encoding="utf-8"?>
<!-- Autenticação em SharedPreferences; dados no Firestore -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="eletricarlos_auth"/>
    </cloud-backup>
    
    <device-transfer>
        <include domain="sharedpref" path="eletricarlos_auth"/>
    </device-transfer>
</data-extraction-rules>
